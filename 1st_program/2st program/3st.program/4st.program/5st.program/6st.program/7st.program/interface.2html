export default function RegistrationForm() {
  return (
    <form>
      <h2>Create Account</h2>

      <input
        type="text"
        placeholder="Full Name"
        required
        minLength="3"
      />

      <input
        type="email"
        placeholder="Email"
        required
      />

      <input
        type="password"
        placeholder="Password"
        required
        minLength="8"
      />

      <input
        type="tel"
        placeholder="Phone Number"
        pattern="[0-9]{10}"
        required
      />

      <button type="submit">Register</button>
    </form>
  );
}
