import React, { useState } from "react";

function Counter() {

    const [count, setCount] = useState(0);

    return (
        <div style={{
            textAlign: "center",
            marginTop: "100px",
            fontFamily: "Arial"
        }}>

            <h1>Counter Application</h1>

            <h2 style={{ color: "blue" }}>
                {count}
            </h2>

            <button onClick={() => setCount(count + 1)}>
                Increase
            </button>

            <button onClick={() => setCount(count - 1)}>
                Decrease
            </button>

            <button onClick={() => setCount(0)}>
                Reset
            </button>

        </div>
    );
}

export default Counter;
